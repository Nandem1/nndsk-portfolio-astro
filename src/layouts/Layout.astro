---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { SITE_METADATA } from '@/utils/constants';
import { AUTHOR_META, relMeHrefs } from '@/utils/identity';
import { personWebSiteJsonLd } from '@/utils/jsonLd';

interface Props {
  title?: string;
  description?: string;
  robots?: string;
  image?: string;
  imageAlt?: string;
}

const {
  title = SITE_METADATA.title,
  description = SITE_METADATA.description,
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  image,
  imageAlt = SITE_METADATA.title,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = image ? new URL(image, Astro.site) : new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <Font cssVariable="--font-inter" preload />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR_META} />
    <meta name="theme-color" content="#17191c" />
    <meta name="robots" content={robots} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:site_name" content="nndsk" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <link rel="manifest" href="/manifest.webmanifest" />

    <link rel="canonical" href={canonicalURL} />

    {relMeHrefs().map(href => (
      <link rel="me" href={href} />
    ))}

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(personWebSiteJsonLd())}
    />

    <title>{title}</title>
    <script is:inline>
      (() => {
        const enter = () => document.documentElement.setAttribute('data-enter', '');
        const settleHash = () => {
          const id = location.hash.slice(1);
          if (!id) return;
          const el = document.getElementById(id);
          if (!el) return;
          el.scrollIntoView({ block: 'start', behavior: 'instant' });
        };
        if ('onpagereveal' in window) {
          addEventListener('pagereveal', event => {
            if (event.viewTransition) {
              settleHash();
              return;
            }
            enter();
          });
        } else {
          enter();
        }
      })();
    </script>
  </head>
  <body class="min-h-screen">
    <a href="#main-content" class="skip-link">
      Saltar al contenido principal
    </a>

    <slot />

    <script is:inline src="/_vercel/insights/script.js" defer></script>
    <script is:inline src="/scripts/site.js" defer></script>
  </body>
</html>
