---
/**
 * Componente hero con avatar, título, descripción y llamadas a acción.
 * Utiliza imagen optimizada de GitHub avatar con formato WebP.
 */
import OptimizedPicture from '@/components/OptimizedPicture.astro';
import { AVATAR_URL } from '@/utils/constants';

const avatarUrl = AVATAR_URL;
---

<section
  class="min-h-screen flex flex-col justify-center items-center px-6 py-20 relative"
  aria-labelledby="hero-title"
>
  <div class="max-w-2xl w-full text-center space-y-8">
    {/* Avatar con Image component */}
    <div class="flex justify-center" data-hero style="--hero-delay: 0ms">
      <div
        class="w-32 h-32 rounded-full overflow-hidden ring-1 ring-border ring-offset-2 ring-offset-background"
      >
        <OptimizedPicture
          src={avatarUrl}
          alt="Avatar del desarrollador"
          width={128}
          height={128}
          quality={80}
          class="w-full h-full object-cover"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
    </div>

    <div class="space-y-4" data-hero style="--hero-delay: 100ms">
      <h1
        id="hero-title"
        class="text-5xl md:text-6xl font-semibold text-foreground tracking-normal"
      >
        Nande — Fullstack Developer
      </h1>
      <p class="text-xl text-accent font-medium">TypeScript • Go • Rust</p>
    </div>

    <p
      class="text-muted text-lg max-w-lg mx-auto leading-relaxed"
      data-hero
      style="--hero-delay: 200ms"
    >
      Mantengo el ERP de Mercado House, soy desarrollador fullstack en EcoRetirosRM y construyo
      tooling en Rust. Trabajo con flujo agentico — Claude Code, Codex, OpenCode. TypeScript, Rust,
      Go — en ese orden, por ahora.
    </p>

    <div
      class="flex flex-col sm:flex-row justify-center items-center gap-3 sm:gap-4 pt-4"
      data-hero
      style="--hero-delay: 300ms"
    >
      <a
        href="#bio"
        class="inline-flex items-center py-3 font-medium text-muted hover:text-foreground transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-accent/50 focus:ring-offset-2 focus:ring-offset-background rounded-sm"
      >
        Sobre mí
      </a>
      <a
        href="#work"
        class="px-6 py-3 text-foreground border border-border rounded-md hover:border-accent hover:text-accent transition-colors duration-200 font-medium focus:outline-none focus:ring-2 focus:ring-accent/50 focus:ring-offset-2 focus:ring-offset-background"
      >
        Ver trabajos
      </a>
      <a
        href="#contact"
        class="inline-flex items-center py-3 font-medium text-muted hover:text-foreground transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-accent/50 focus:ring-offset-2 focus:ring-offset-background rounded-sm"
      >
        Escríbeme
      </a>
    </div>
  </div>
</section>
