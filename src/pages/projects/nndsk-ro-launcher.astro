---
export const prerender = true;

import { getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import OptimizedPicture from '@/components/OptimizedPicture.astro';
import GitHubIcon from '@/components/icons/GitHubIcon.astro';
import RoLauncherDemo from '@/components/ro-launcher-demo/RoLauncherDemo.tsx';
import { SITE_METADATA } from '@/utils/constants';
import {
  breadcrumbListJsonLd,
  faqPageJsonLd,
  softwareApplicationJsonLd,
  websiteId,
} from '@/utils/jsonLd';
import { backLinkClass, ctaGhost, ctaPrimary } from '@/utils/ui';

const project = await getEntry('projects', 'nndsk-ro-launcher');
if (!project) {
  throw new Error('Missing projects entry nndsk-ro-launcher');
}
if (!project.data.thumbnail) {
  throw new Error('Missing thumbnail for nndsk-ro-launcher');
}

const title = 'nndsk-ro-launcher: launcher de Ragnarok Online para Linux';
const description =
  'nndsk-ro-launcher (RO-Launcher) es un launcher de Ragnarok Online para Linux: Tauri v2, React y Rust. WINEPREFIX, DXVK/Vulkan, AutoPot y supervisor de sesión.';

const og = await getImage({
  src: project.data.thumbnail,
  width: 1200,
  height: 630,
  format: 'jpg',
  fit: 'cover',
});
const ogImageHref = new URL(og.src, Astro.site).href;

const screenshot = await getImage({
  src: project.data.thumbnail,
  width: 1200,
  height: 675,
  format: 'jpg',
});
const screenshotHref = new URL(screenshot.src, Astro.site).href;

const pageUrl = `${SITE_METADATA.url}/projects/nndsk-ro-launcher/`;
const appId = `${pageUrl}#app`;
const webpageId = `${pageUrl}#webpage`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const faqId = `${pageUrl}#faq`;

const faqs = [
  {
    question: '¿Sirve para servidores privados?',
    answer:
      'Cada servidor tiene su perfil (runner, WINEPREFIX, DXVK). No afirmamos compatibilidad con todos.',
  },
  {
    question: '¿Hace falta ptrace_scope=0?',
    answer:
      'No. ro-sessiond lee el cliente con Yama en default: sin ptrace_scope=0 y sin sudo.',
  },
  {
    question: '¿Modifica Gepard o el cliente?',
    answer:
      'No. Si el hash de gepard.dll no está en la matriz, hay advertencia; no receta de runner.',
  },
];

const { '@context': _context, ...appNode } = softwareApplicationJsonLd(project, {
  id: appId,
  url: pageUrl,
  description,
  applicationCategory: 'GameApplication',
  operatingSystem: 'Linux',
  alternateName: ['RO-Launcher', 'RO Launcher'],
  image: screenshotHref,
  isPartOf: { '@id': websiteId() },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
});

const caseStudyJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': webpageId,
      url: pageUrl,
      name: title,
      description,
      inLanguage: 'es-CL',
      isPartOf: { '@id': websiteId() },
      mainEntity: { '@id': appId },
    },
    appNode,
    breadcrumbListJsonLd(breadcrumbId, [
      { name: 'Inicio', item: `${SITE_METADATA.url}/` },
      { name: 'nndsk-ro-launcher', item: pageUrl },
    ]),
    faqPageJsonLd(faqId, faqs),
  ],
};

const technicalRuntime = [
  {
    lead: 'Perfiles aislados',
    rest: 'cambiar runner crea o reutiliza otro prefix; no migra ni borra el anterior.',
  },
  {
    lead: 'Runners',
    rest: 'Proton-CachyOS + UMU administrados, o Wine portable bajo ~/.local/share/ro-launcher/runners/.',
  },
  {
    lead: 'Gepard',
    rest: 'recomendación de runner solo si el SHA-256 de gepard.dll coincide con la matriz validada. Hash desconocido = advertencia, no receta.',
  },
  {
    lead: 'Sin tocar el cliente',
    rest: 'el launcher no modifica Gepard, el cliente ni el tráfico del juego.',
  },
];

const pipelineRoutes: string[][] = [
  ['D3D 8/9/11', 'DXVK', 'Vulkan'],
  ['DirectDraw', 'dgVoodoo', 'D3D11', 'DXVK', 'Vulkan'],
];

const pipelinePillClass =
  'inline-flex px-2 py-0.5 text-xs rounded-sm bg-transparent text-muted border border-border font-mono';

const technicalHerramientas = [
  {
    lead: 'AutoPot / AutoBuff / Spammer',
    rest: 'lectura de memoria (perfiles 4RTools). Spammer con sidecar evdev + ydotool, hotkeys F1–F9 / 0–9.',
  },
  {
    lead: 'ro-sessiond',
    rest: 'child subreaper, padre de wineserver, patcher y ragexe.exe. No hace falta ptrace_scope=0 ni sudo.',
  },
];

const stackChips = [
  'Tauri v2',
  'Rust',
  'React',
  'Wine',
  'Proton',
  'DXVK',
  'dgVoodoo',
  'UMU',
];

const galleryImage = project.data.gallery?.[0];
const ogImageAlt =
  'RO-Launcher (nndsk-ro-launcher) — launcher de Ragnarok Online para Linux';
---

<style is:global>
  #demo {
    overflow-anchor: none;
  }
</style>

<Layout title={title} description={description} image={ogImageHref} imageAlt={ogImageAlt}>
  <Header />
  <main id="main-content" class="px-6 pt-8 pb-24">
    <article class="max-w-5xl mx-auto">
      <script type="application/ld+json" set:html={JSON.stringify(caseStudyJsonLd)} is:inline />

      <div class="max-w-3xl">
        <nav aria-label="Miga de pan">
          <ol class="flex flex-wrap items-center gap-2 text-sm text-muted mb-8">
            <li><a href="/" class={backLinkClass}>Inicio</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/#work" class={backLinkClass}>Trabajos</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-foreground" aria-current="page">nndsk-ro-launcher</li>
          </ol>
        </nav>

        <h1 class="text-4xl md:text-5xl font-semibold text-foreground tracking-normal mb-3">
          RO-Launcher — launcher de Ragnarok Online para Linux
        </h1>
        <p class="text-sm font-mono text-muted mb-6 md:mb-8">2026 · Tauri v2 · React · Rust</p>

        {
          project.data.github && (
            <div class="flex flex-wrap gap-3 mb-8 md:hidden">
              <a
                href={project.data.github}
                target="_blank"
                rel="noopener noreferrer"
                class={ctaPrimary}
                aria-label="Ver código en GitHub: nndsk-ro-launcher"
              >
                <GitHubIcon class="w-4 h-4" />
                Repo
              </a>
            </div>
          )
        }
      </div>

      {
        project.data.thumbnail && (
          <div id="demo" class="mt-8">
            <p class="text-sm text-muted mb-3 max-w-3xl">
              Demo de la UI. No lanza el juego ni instala Wine.
            </p>
            <RoLauncherDemo client:load variant="full" />
            <noscript>
              <figure class="mt-4 max-w-3xl">
                <OptimizedPicture
                  src={project.data.thumbnail}
                  alt="Interfaz de nndsk-ro-launcher (RO-Launcher) en Linux: servidor HoneyRO, runner proton-cachyos-slr, AutoPot y Spammer"
                  width={1200}
                  height={675}
                  widths={[800, 1200]}
                  sizes="(max-width: 768px) 100vw, 1200px"
                  quality={80}
                  loading="eager"
                  decoding="async"
                  class="w-full h-auto rounded-md border border-border"
                />
                <figcaption class="text-sm text-muted mt-2">
                  Activa JavaScript para usar la demo.
                </figcaption>
              </figure>
            </noscript>
          </div>
        )
      }

      <div class="max-w-3xl">
      <h2 class="text-xl font-semibold text-foreground mt-12 mb-4">Problema</h2>
      <p class="text-muted leading-relaxed">
        Ragnarok Online en Linux no es instalar y jugar. Cada servidor privado trae su runner, su
        prefix y a veces un anticheat distinto. Armar Wine + DXVK + dgVoodoo a mano se rompe entre
        máquinas. Leer HP/SP del cliente para AutoPot suele empujar a ptrace_scope=0. Eso no va a ser
        un requisito.
      </p>

      <h2 class="text-xl font-semibold text-foreground mt-12 mb-4">Enfoque</h2>
      <p class="text-muted leading-relaxed">
        Un launcher de escritorio, no un script. Tauri v2 + React en la UI, Rust en el host. Un
        perfil por servidor: runner, WINEPREFIX, DXVK, dgVoodoo si el cliente es DirectDraw. AutoPot,
        AutoBuff y el spammer salen del mismo lanzamiento. Un sidecar ro-sessiond queda de padre del
        proceso del juego para leer memoria con Yama en default.
      </p>

      <h2 class="text-xl font-semibold text-foreground mt-12 mb-4">Técnico</h2>

      <h3 class="text-base font-semibold text-foreground mt-6 mb-3">Runtime</h3>
      <div class="mb-6" aria-label="Pipeline gráfico">
        <p class="text-xs font-mono text-muted mb-2">Pipeline</p>
        <div class="flex flex-col gap-2">
          {
            pipelineRoutes.map((route) => (
              <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
                {route.map((stage, i) => (
                  <li class="inline-flex items-center gap-x-1.5">
                    {i > 0 && (
                      <span class="text-xs font-mono text-muted select-none" aria-hidden="true">
                        →
                      </span>
                    )}
                    <span class={pipelinePillClass}>{stage}</span>
                  </li>
                ))}
              </ol>
            ))
          }
        </div>
      </div>
      <ul class="space-y-1.5" aria-label="Runtime">
        {
          technicalRuntime.map((item) => (
            <li class="flex gap-2 text-sm text-muted">
              <span class="text-muted mt-0.5 shrink-0" aria-hidden="true">
                –
              </span>
              <span>
                <span class="text-foreground font-medium">{item.lead}:</span>{' '}{item.rest}
              </span>
            </li>
          ))
        }
      </ul>

      <h3 class="text-base font-semibold text-foreground mt-8 mb-3">Herramientas</h3>
      <ul class="space-y-1.5" aria-label="Herramientas">
        {
          technicalHerramientas.map((item) => (
            <li class="flex gap-2 text-sm text-muted">
              <span class="text-muted mt-0.5 shrink-0" aria-hidden="true">
                –
              </span>
              <span>
                <span class="text-foreground font-medium">{item.lead}:</span>{' '}{item.rest}
              </span>
            </li>
          ))
        }
      </ul>

      <section aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="text-xl font-semibold text-foreground mt-12 mb-4">
          Preguntas frecuentes
        </h2>
        {
          faqs.map((faq) => (
            <div>
              <h3 class="text-base font-semibold text-foreground mt-6 mb-2">{faq.question}</h3>
              <p class="text-muted leading-relaxed">{faq.answer}</p>
            </div>
          ))
        }
      </section>

      <h2 class="text-xl font-semibold text-foreground mt-12 mb-4">Stack</h2>
      <ul class="flex flex-wrap gap-2" aria-label="Stack técnico">
        {
          stackChips.map((tech) => (
            <li>
              <span class="px-2 py-0.5 text-xs rounded-sm bg-transparent text-muted border border-border font-mono">
                {tech}
              </span>
            </li>
          ))
        }
      </ul>

      {
        galleryImage && (
          <figure class="mt-8">
            <OptimizedPicture
              src={galleryImage}
              alt="nndsk-ro-launcher superpuesto sobre el cliente de Ragnarok Online en Linux, con AutoPot activo"
              width={1200}
              height={675}
              widths={[800, 1200]}
              sizes="(max-width: 768px) 100vw, 1200px"
              quality={80}
              loading="lazy"
              decoding="async"
              class="w-full h-auto rounded-md border border-border"
            />
            <figcaption class="text-sm text-muted mt-2">
              La app sobre el cliente, en Linux.
            </figcaption>
          </figure>
        )
      }

      <h2 class="text-xl font-semibold text-foreground mt-12 mb-4">Links</h2>
      <div class="flex flex-col sm:flex-row flex-wrap gap-3">
        {
          project.data.github && (
            <a
              href={project.data.github}
              target="_blank"
              rel="noopener noreferrer"
              class={ctaPrimary}
              aria-label="Ver código en GitHub: nndsk-ro-launcher"
            >
              <GitHubIcon class="w-4 h-4" />
              Repo
            </a>
          )
        }
        <a href="/#work" class={ctaGhost}>
          ← Trabajos
        </a>
      </div>
      </div>
    </article>
  </main>
  <Footer />
</Layout>
