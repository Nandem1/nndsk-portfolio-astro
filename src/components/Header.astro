---
/**
 * Componente de cabecera con navegación principal.
 * Enlaces de ancla a secciones de la home con scroll suave.
 */
import { NAV_LINKS } from '@/utils/constants';

interface NavLink {
  href: string;
  label: string;
}

const navLinks: NavLink[] = NAV_LINKS;
---

<div id="top"></div>
<header class="sticky top-0 z-50 h-16 w-full border-b border-border bg-background">
  <nav
    class="h-full max-w-3xl mx-auto flex items-center justify-between px-6"
    aria-label="Navegación principal"
  >
    {/* Logo */}
    <a
      href="/#top"
      class="text-foreground font-semibold text-base sm:text-lg hover:opacity-80 transition-opacity"
    >
      nndsk
    </a>

    {/* Navigation Links */}
    <ul class="flex items-center gap-2 sm:gap-6" role="list">
      {
        navLinks.map((link) => {
          return (
            <li>
              <a
                href={link.href}
                class="text-sm font-medium transition-colors duration-200 text-muted hover:text-foreground focus:outline-none focus:ring-2 focus:ring-accent/50 focus:ring-offset-2 focus:ring-offset-background rounded-sm px-2 py-1"
              >
                {link.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>
